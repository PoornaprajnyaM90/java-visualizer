PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
SANDBOX_IMAGE=java-visualizer-sandbox:latest
MAX_CONCURRENT=4
# Optional: enables the AI "Explain every line" layer. Server-side only, never ship to the browser.
ANTHROPIC_API_KEY=
EXPLAIN_MODEL=claude-sonnet-5-5

# --- production only (leave commented in development) ---
# HOST=127.0.0.1
# TRUST_PROXY=1
# FRONTEND_ORIGIN=https://your-domain.example
